# ========================
# Invernadero Inteligente
# .gitignore
# ========================

# Variables de entorno (nunca subir a Git)
.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# React build
frontend/build/

# Python
__pycache__/
*.py[cod]
bridge/venv/
bridge/.venv/
*.egg-info/
dist/

# Arduino / IDE
*.elf
*.bin
*.hex
*.map
build/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.suo
*.user
